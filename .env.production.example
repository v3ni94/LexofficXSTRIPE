# ============================================================
# LexSEPA Production Environment Variables
# Copy to .env and fill in all values before deploying.
# ============================================================

# ------------------------------------------------------------
# Domain
# ------------------------------------------------------------
# Your public domain name (used by nginx for SSL certs and virtual hosting)
DOMAIN=lexsepa.example.com
SSL_EMAIL=admin@example.com

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_db_password

# ------------------------------------------------------------
# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# ------------------------------------------------------------
JWT_SECRET_KEY=change_me_jwt_secret_64_chars_minimum

# ------------------------------------------------------------
# Encryption key for storing Lexoffice / Stripe API keys at rest
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------
ENCRYPTION_KEY=change_me_fernet_key_base64

# ------------------------------------------------------------
# Stripe (platform-level keys — optional if using per-tenant keys only)
# ------------------------------------------------------------
# STRIPE_PLATFORM_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
LOG_LEVEL=INFO

# CORS origins — comma-separated list of allowed frontend origins
# CORS_ORIGINS=https://lexsepa.example.com
