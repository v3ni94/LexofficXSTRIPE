# SmartEinzug (SEPA-Portal, Müller Holding AG), Apache-Konfiguration (IONOS)
#
# Hosts: Dieselbe Verzeichniskopie bedient app.smart-einzug.de, künftig
# app.smart-einzug.de und admin.smart-einzug.de. Die Zuordnung der Hosts
# (Allowlist, Trennung Admin/Kunden) erfolgt NICHT hier, sondern in PHP über
# app/config.php (allowed_hosts, app_base_url, admin_base_url), siehe
# app/bootstrap.php. Keine Host-Weiterleitungen in dieser Datei eintragen:
# Stripe-Webhooks (POST) dürfen nicht per 301 umgeleitet werden, die alten
# Endpunkte bleiben parallel gültig.

# Startseite explizit festlegen
DirectoryIndex index.php

# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Interne Verzeichnisse und sensible Dateien vor Webzugriff schützen
RewriteRule ^app/ - [F,L]
RewriteRule ^sql/ - [F,L]
<FilesMatch "\.(sql|md|log|jar|example\.php)$">
    Require all denied
</FilesMatch>

# Verzeichnislisten deaktivieren
Options -Indexes

# Statische Dateien: CSS und JS werden mit Versionsparameter eingebunden
# (asset_url in app/bootstrap.php) und dürfen deshalb lange gecacht werden.
# Bilder ohne Versionsparameter kürzer, damit ein Austausch sichtbar wird.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Die Anwendung gehört nicht in Suchmaschinen (Login, Dashboard, Kundendaten)
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
