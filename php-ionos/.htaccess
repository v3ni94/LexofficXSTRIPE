# HVM SEPA-Portal – Apache-Konfiguration (IONOS)

# Startseite explizit festlegen
DirectoryIndex index.php

# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Interne Verzeichnisse und sensible Dateien vor Webzugriff schützen
RewriteRule ^app/ - [F,L]
RewriteRule ^sql/ - [F,L]
<FilesMatch "\.(sql|md|log|jar|example\.php)$">
    Require all denied
</FilesMatch>

# Verzeichnislisten deaktivieren
Options -Indexes

# Sicherheits-Header
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
