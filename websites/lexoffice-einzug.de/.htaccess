# lexoffice-einzug.de (Apache, IONOS)
RewriteEngine On
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes -MultiViews

# Ein kanonischer Host, genau ein 301: http und www auf https://lexoffice-einzug.de
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^lexoffice-einzug\.de$ [NC]
RewriteRule ^(.*)$ https://lexoffice-einzug.de/$1 [R=301,L]

# Alte Adressen dauerhaft weiterleiten
RewriteRule ^lexoffice-sepa(\.html)?$ /lexoffice-sepa-lastschrift [R=301,L]
RewriteRule ^lexoffice-stripe(\.html)?$ /lexoffice-stripe-lastschrift [R=301,L]

# .html-Endung entfernen (externe Anfragen), 404 und Rechtstexte ausgenommen
RewriteCond %{THE_REQUEST} \s/([^\s?]+?)(?:/index)?\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1 [R=301,L]

# Extensionslose URLs intern auf die .html-Datei auflösen
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://app.lexware-einzug.de; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://app.lexware-einzug.de; object-src 'none'; require-trusted-types-for 'script'"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
