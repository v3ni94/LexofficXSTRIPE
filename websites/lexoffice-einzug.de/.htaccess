# lexoffice-einzug.de (Apache, IONOS)
RewriteEngine On
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes -MultiViews

# Ein kanonischer Host, genau ein 301: http und www auf https://lexoffice-einzug.de
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^lexoffice-einzug\.de$ [NC]
RewriteRule ^(.*)$ https://lexoffice-einzug.de/$1 [R=301,L]

# Alte Adressen dauerhaft weiterleiten
RewriteRule ^lexoffice-sepa(\.html)?$ / [R=301,L]
RewriteRule ^lexoffice-stripe(\.html)?$ / [R=301,L]

# Verlagerung dauerhafter Inhalte auf die Hauptdomain und Zusammenfuehrung gleichartiger Seiten (08.09.2026)
RewriteRule ^ratgeber/sepa\-mandat\-einholen\-bestandskunden(\.html)?/?$ https://smart-einzug.de/wissen/sepa-mandat-einholen/ [R=301,L]
RewriteRule ^ratgeber/lexoffice\-lastschrift\-oder\-ueberweisung(\.html)?/?$ https://smart-einzug.de/wissen/lastschrift-oder-ueberweisung/ [R=301,L]
RewriteRule ^ratgeber/kunden\-und\-rechnungen\-richtig\-zuordnen(\.html)?/?$ https://smart-einzug.de/wissen/kunden-und-rechnungen-zuordnen/ [R=301,L]
RewriteRule ^ratgeber/was\-brauche\-ich\-fuer\-eine\-sepa\-lastschrift(\.html)?/?$ https://smart-einzug.de/wissen/voraussetzungen-sepa-lastschrift/ [R=301,L]
RewriteRule ^ratgeber/warum\-ist\-eine\-lastschrift\-nicht\-sofort\-bezahlt(\.html)?/?$ https://smart-einzug.de/wissen/zahlungsstatus-einer-lastschrift/ [R=301,L]
RewriteRule ^ratgeber/wie\-funktioniert\-ein\-sepa\-mandat(\.html)?/?$ https://smart-einzug.de/wissen/sepa-mandat/ [R=301,L]
RewriteRule ^ratgeber/was\-passiert\-bei\-einer\-ruecklastschrift(\.html)?/?$ https://smart-einzug.de/wissen/ruecklastschrift/ [R=301,L]
RewriteRule ^ratgeber/?$ https://smart-einzug.de/wissen/ [R=301,L]
RewriteRule ^lexoffice\-public\-api\-xl(\.html)?/?$ https://smart-einzug.de/anleitungen/lexware-office-verbinden/ [R=301,L]
RewriteRule ^lexoffice\-lastschrift\-einrichten(\.html)?/?$ https://smart-einzug.de/anleitungen/ [R=301,L]
RewriteRule ^lexoffice\-lastschrift(\.html)?/?$ / [R=301,L]
RewriteRule ^lexoffice\-sepa\-lastschrift(\.html)?/?$ / [R=301,L]
RewriteRule ^lexoffice\-lastschrifteinzug(\.html)?/?$ / [R=301,L]
RewriteRule ^lexoffice\-stripe\-lastschrift(\.html)?/?$ / [R=301,L]
RewriteRule ^lexoffice\-sepa\-mandat(\.html)?/?$ / [R=301,L]

# .html-Endung entfernen (externe Anfragen), 404 und Rechtstexte ausgenommen
RewriteCond %{THE_REQUEST} \s/([^\s?]+?)(?:/index)?\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1 [R=301,L]

# Extensionslose URLs intern auf die .html-Datei auflösen
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net https://td.doubleclick.net https://www.google.com https://www.google.de; font-src 'self'; connect-src 'self' https://app.smart-einzug.de https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net https://td.doubleclick.net https://www.google.com https://www.google.de; frame-src https://td.doubleclick.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://app.smart-einzug.de; object-src 'none'"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
