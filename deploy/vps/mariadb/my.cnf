# SmartEinzug: zusaetzliche MariaDB-Einstellungen fuer den VPS-Container (mariadb:10.11).
# Wird als /etc/mysql/conf.d/smarteinzug.cnf eingebunden und ergaenzt die Standardkonfiguration
# des Images, ohne sie zu ersetzen.
#
# Die Werte sind auf einen kleinen bis mittleren VPS ausgelegt (siehe Ressourcenlimits in
# docker-compose.prod.yml/staging.yml, Dienst mariadb). Vor einer Kapazitaetsaenderung des VPS
# innodb_buffer_pool_size anpassen (Faustregel: rund 60-70% des mem_limit des mariadb-Dienstes).

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Verbindungen und Zeitzone
max_connections      = 100
default_time_zone    = '+00:00'

# InnoDB: Puffer an das Speicherlimit des Containers angepasst (siehe Kommentar oben).
innodb_buffer_pool_size      = 512M
innodb_buffer_pool_instances = 1
innodb_log_file_size         = 128M
innodb_flush_method          = O_DIRECT
innodb_flush_log_at_trx_commit = 1

# Fuer bin/host-metrics.php (db_slow_queries) genuegt der globale Zaehler Slow_queries, der immer
# mitgefuehrt wird; das Slow-Query-Log selbst bleibt aus, um Schreiblast auf dem VPS zu sparen. Bei
# Bedarf fuer eine gezielte Analyse hier befristet aktivieren:
# slow_query_log     = 1
# slow_query_log_file = /var/lib/mysql/slow.log
# long_query_time    = 2

# Grundsaetzliche Haertung
local_infile         = 0
skip_name_resolve    = 1
