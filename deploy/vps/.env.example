# SmartEinzug: Umgebungsvariablen fuer den Docker-Stack auf dem VPS (Hostinger KVM 8 mit Coolify).
# Nach .env kopieren und Werte eintragen. .env NIEMALS einchecken (siehe .gitignore im Repo-Wurzelordner
# und Hinweis in README.md). Enthaelt selbst KEINE echten Werte, nur Platzhalter.
#
# Getrennte .env je Umgebung: Produktion und Staging laufen mit jeweils eigener .env und eigener
# Coolify-Datenbankressource (siehe README.md, Abschnitt "Start").
#
# Datenbankzugangsdaten stehen NICHT hier, sondern ausschliesslich in /opt/smarteinzug/shared/config.php
# (db.host = Containername der Coolify-MariaDB, db.name = smarteinzug, db.user/db.pass aus Coolify).

# --- Zeitzone -------------------------------------------------------------------------------------
TZ=Europe/Berlin

# --- Domains (ohne https://, ohne Slash) ---------------------------------------------------------
# Produktion: alle vier Variablen setzen (docker-compose.prod.yml).
# Staging: nur DOMAIN_STAGING setzen, die vier anderen leer lassen (docker-compose.staging.yml
# nutzt ohnehin Caddyfile.staging, das nur DOMAIN_STAGING liest).
DOMAIN_APP=app.smart-einzug.de
DOMAIN_ADMIN=admin.smart-einzug.de
DOMAIN_API=api.smart-einzug.de
DOMAIN_STATUS=status.smart-einzug.de
DOMAIN_STAGING=staging.smart-einzug.de

# --- Coolify-Netz und -Datenbank -----------------------------------------------------------------------
# Name des Docker-Netzes von Coolify: darin laufen der Coolify-Proxy (Traefik, beendet TLS) und die
# Coolify-MariaDB. Caddy haengt daran fuer den Proxy, die PHP-Container fuer Datenbank und Internet.
# Auf dem Server pruefen: docker network ls (Standard: coolify) und
# docker inspect <db-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
COOLIFY_NETWORK=coolify
# Containername der Coolify-MariaDB (docker ps, oder in Coolify unter der Datenbank in der internen
# Verbindungsadresse). Wird nur von scripts/db-import.sh und fuer Wiederherstellungstests verwendet;
# die Anwendung selbst liest db.host aus shared/config.php.
DB_CONTAINER=HIER-CONTAINERNAME-DER-COOLIFY-MARIADB
# Hostpfad der lokalen Kopien der Coolify-Datenbankbackups (nur lesend fuer den Metrik-Sammler).
# Standard bei Coolify: /data/coolify/backups (auf dem Server pruefen, siehe docs/vps/08).
COOLIFY_BACKUP_DIR=/data/coolify/backups

# --- Umgebung und Health-Check des Deployments ----------------------------------------------------
# DEPLOY_ENV: prod (docker-compose.prod.yml) oder staging (docker-compose.staging.yml). Wird von
# scripts/deploy.sh und scripts/rollback.sh gelesen.
DEPLOY_ENV=prod
# HEALTH_STRICT: true = ein fehlgeschlagener HTTPS-Health-Check ueber den Proxy (lokal, ohne DNS) fuehrt
# nach dem Deployment zum automatischen Rollback. false = nur Warnung im Protokoll. Vor dem Cutover
# (DNS zeigt noch auf das Webhosting, Let's Encrypt kann noch kein Zertifikat ausstellen) auf false
# lassen, nach erfolgreichem Cutover auf true setzen.
HEALTH_STRICT=false

# --- Dateirechte (php-fpm laeuft nicht als root) --------------------------------------------------
# UID/GID des Benutzers "deploy" auf dem Host, damit die Bind-Mounts unter /opt/smarteinzug
# (releases/, shared/config.php, shared/storage, shared/sessions) fuer den Container lesbar bzw.
# beschreibbar sind. Ermitteln auf dem VPS mit: id deploy
APP_UID=1000
APP_GID=1000

# --- PHP-FPM (Web) ---------------------------------------------------------------------------------
# Hostinger KVM 8 (32 GB): 16 Kindprozesse bei 1,5 GB Limit des php-Dienstes sind reichlich; Staging 8.
PM_MAX_CHILDREN=16

# --- Worker/Scheduler ------------------------------------------------------------------------------
# memory_limit der Hintergrundprozesse (php -d memory_limit=...M), siehe deploy/vps/php/php.ini.
WORKER_MEMORY_MB=512
# Anzahl der Lexware-Worker ist fest (zwei in Produktion, einer in Staging); mehr bringt wegen der
# API-Ratenbegrenzung nichts.
