########################################################################################
# SmartEinzug: Caddy-Konfiguration fuer den Produktions-VPS.
#
# Ersetzt vollstaendig die Apache-Regeln aus php-ionos/.htaccess (dort ausfuehrlich kommentiert)
# und teilt eine PHP-Anwendung auf drei Hosts auf:
#   {$DOMAIN_APP}    Kundenanwendung (voller Funktionsumfang)
#   {$DOMAIN_ADMIN}  Adminbereich (Host-Trennung erfolgt zusaetzlich in PHP, siehe app/bootstrap.php
#                    enforce_host_rules(); Caddy behandelt beide Hosts hier bewusst identisch)
#   {$DOMAIN_API}    NUR die vier Endpunkte stripe-webhook.php, billing-webhook.php, health.php,
#                    track.php; jede andere Anfrage erhaelt 404 (Verteidigung zusaetzlich zur
#                    Anwendung selbst, die diese Endpunkte ebenfalls selbst absichert)
#   {$DOMAIN_STATUS} statische Statusseite (websites/status.smart-einzug.de, im Release unter status/), kein PHP
#
# HTTPS-Umleitung und Let's Encrypt-Zertifikate uebernimmt der Coolify-Proxy (Traefik) auf 80/443;
# dieser Caddy ist der interne HTTP-Server hinter dem Proxy (Begruendung: README.md, "Warum Caddy").
########################################################################################

{
	# TLS und Let's Encrypt uebernimmt der Coolify-Proxy (Traefik) vor diesem Container. Caddy spricht
	# hier nur HTTP auf Port 80 im Docker-Netz; kein eigener Zertifikatsbezug, keine eigene Umleitung.
	auto_https off
}

# --- Wiederverwendbare Bausteine --------------------------------------------------------------

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Anwendung gehoert nicht in Suchmaschinen (Login, Dashboard, Kundendaten).
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# HSTS erst nach Freischaltung aktivieren: erst wenn app-, admin- und api-Host dauerhaft
		# ausschliesslich unter gueltigem HTTPS erreichbar sind (ein falsch gesetzter HSTS-Header
		# laesst sich wegen des Browser-Caches nicht kurzfristig zuruecknehmen). Bis dahin
		# auskommentiert lassen und erst nach ausdruecklicher Freigabe durch die Geschaeftsfuehrung
		# einkommentieren:
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Entspricht ".htaccess": RewriteRule ^app/ - [F,L] / RewriteRule ^sql/ - [F,L] sowie der
# FilesMatch-Sperre fuer .sql .md .log .jar .example.php.
(deny_internal_paths) {
	# Innerhalb eines Release liegen zusaetzlich deploy/ (Compose, Skripte), bin/ (CLI-Werkzeuge) und
	# status/ (Statusseite, wird nur ueber den Status-Host ausgeliefert); alle nie ueber HTTP erreichbar.
	@internal_dirs path /app/* /sql/* /deploy/* /bin/* /status/*
	respond @internal_dirs 403

	@denied_ext path *.sql *.md *.log *.jar *.example.php
	respond @denied_ext 403

	# Einrichtungspruefung: nur fuer die Erstinstallation auf dem Webhosting gedacht, auf dem VPS nie noetig
	# (die Konfiguration liegt dort ausserhalb des Release). Zusaetzliche Sperre neben dem Token in der Datei
	# selbst (Befund der Gesamtpruefung 09.09.2026: das Token-Gate griff auf dem VPS nicht).
	@setup_check path /setup-check.php
	respond @setup_check 403

	# Keine Punktdateien oder -ordner ausliefern (.htaccess, .git*, .env*), unabhaengig von der Tiefe.
	@dotfiles path /.* */.*
	respond @dotfiles 403
}

# Cache-Header wie in .htaccess: CSS/JS mit Versionsparameter (asset_url) lange und "immutable",
# Bilder und Schriften kuerzer, da ohne Versionsparameter eingebunden.
(static_cache) {
	@versioned_assets path *.css *.js
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"

	@static_media path *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.woff *.woff2
	header @static_media Cache-Control "public, max-age=2592000"
}

# --- Kundenanwendung ----------------------------------------------------------------------------
http://{$DOMAIN_APP}:80 {
	import security_headers
	import deny_internal_paths
	import static_cache

	# Entspricht AddOutputFilterByType DEFLATE ... (mod_deflate) der .htaccess.
	encode gzip zstd

	root * /opt/smarteinzug/releases/{$RELEASE_SHA}
	# DirectoryIndex index.php: php_fastcgi versucht automatisch {path} und {path}/index.php.
	php_fastcgi php:9000
	file_server {
		hide .*
	}
}

# --- Adminbereich --------------------------------------------------------------------------------
# Dieselbe Anwendung, derselbe Dokumentenstamm; die eigentliche Trennung (nur Anmeldung, 2FA,
# Passwort, Sicherheit, Abmelden und Assets auf diesem Host erreichbar) erzwingt PHP selbst
# (enforce_host_rules in app/bootstrap.php), sobald admin_base_url in app/config.php gesetzt ist.
http://{$DOMAIN_ADMIN}:80 {
	import security_headers
	import deny_internal_paths
	import static_cache

	encode gzip zstd

	root * /opt/smarteinzug/releases/{$RELEASE_SHA}
	php_fastcgi php:9000
	file_server {
		hide .*
	}
}

# --- API-Host: nur Webhooks, Health-Check und Tracking-Pixel -------------------------------------
http://{$DOMAIN_API}:80 {
	import security_headers
	import deny_internal_paths

	encode gzip zstd

	root * /opt/smarteinzug/releases/{$RELEASE_SHA}

	@allowed_endpoints path /stripe-webhook.php /billing-webhook.php /health.php /track.php
	handle @allowed_endpoints {
		php_fastcgi php:9000
	}
	# Alles andere auf diesem Host: 404, kein file_server (keine Assets, keine anderen Skripte).
	handle {
		respond 404
	}
}

# --- Statusseite (statisch, kein PHP) -------------------------------------------------------------
# Entspricht websites/status.smart-einzug.de/.htaccess.
http://{$DOMAIN_STATUS}:80 {
	# Der Workflow legt die Statusseite je Release unter releases/<sha>/status/ ab; {$RELEASE_SHA}
	# bindet diesen Host an dasselbe Release wie die PHP-Container (siehe docker-compose.yml).
	root * /opt/smarteinzug/releases/{$RELEASE_SHA}/status
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'"
		-Server
	}

	@status_json path *.json
	header @status_json Cache-Control "public, max-age=60, must-revalidate"
	header @status_json Access-Control-Allow-Origin "*"

	@status_html path *.html
	header @status_html Cache-Control "public, max-age=300"

	# status.json kommt NICHT aus dem Release (dort liegt nur der Platzhalter), sondern aus dem
	# gemeinsamen, nur lesend eingebundenen Ordner, in den die Anwendung sie schreibt (config
	# status_publish.file, siehe app/monitor.php status_publish() und docs/status-page.md). deploy.sh
	# legt dort beim Deployment den Platzhalter ab, falls noch keine Statusdaten veroeffentlicht wurden;
	# die Seite ist damit immer lesbar und meldet notfalls ehrlich "Daten veraltet".
	handle /status.json {
		root * /opt/smarteinzug/shared/status
		file_server
	}

	# Alles andere (index.html, Stylesheet, Symbole) kommt aus dem Release.
	handle {
		@denied_here path *.php *.phtml *.md *.log
		respond @denied_here 403
		file_server
	}
}
